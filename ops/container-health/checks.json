  "findme-release-cron-1": {
    "test": [
      "CMD",
      "python",
      "-c",
      "import asyncio,pathlib; from sqlalchemy import text; from app.db.client import SessionLocal; assert any(b'app.scheduler_runner' in p.read_bytes().split(b'\\0') for p in pathlib.Path('/proc').glob('[0-9]*/cmdline')); exec(\"async def check():\\n async with SessionLocal() as db: assert await db.scalar(text('SELECT 1')) == 1\\n\"); asyncio.run(check())"
    ]
  },
